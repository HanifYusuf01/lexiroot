PORT=3000
DATABASE_URL=postgresql://lexiroot:password@localhost:5432/lexiroot
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Google OAuth client IDs accepted as ID-token audiences for /auth/google.
# Web client ID doubles as the mobile app's webClientId.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
# Bundle id accepted as the identity-token audience for /auth/apple.
APPLE_BUNDLE_ID=com.lexiroot.mobile
# --- Payments / subscriptions ---
# Provider is resolved per-checkout from platform + user country (Paystack in its
# African markets, Stripe elsewhere). This is only the last-resort fallback when
# no preferred provider is configured; leave BLANK to fall back to whatever is
# available rather than pinning a default.
PAYMENTS_DEFAULT_PROVIDER=
# Stripe: use test-mode keys (sk_test_...) in development.
STRIPE_SECRET_KEY=
# From `stripe listen` (whsec_...) locally, or the dashboard endpoint secret.
STRIPE_WEBHOOK_SECRET=
# Paystack: test-mode secret key (sk_test_...). The SAME key verifies webhooks —
# there is no separate webhook secret. Setting this makes Paystack "live" in the
# provider registry, so leave it blank until tested against Paystack test mode.
PAYSTACK_SECRET_KEY=
# Optional currency override for Paystack plans (NGN, GHS, ZAR, USD, KES…).
# Leave BLANK to use your Paystack account's own default currency — no country
# is assumed. Set it only if your account has multiple currencies enabled.
PAYSTACK_CURRENCY=
# Apple IAP: App Store Server API credentials, from App Store Connect →
# Users and Access → Integrations → In-App Purchase. Create/download a key
# there for the issuer id, key id and .p8 private key.
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# PEM contents of the downloaded SubscriptionKey_<keyId>.p8, with real
# newlines replaced by literal \n (env vars can't hold multi-line values).
APPLE_IAP_PRIVATE_KEY=
# Numeric App Store app id (Connect → App Information → Apple ID). Required
# once ENVIRONMENT=Production; unused in Sandbox.
APPLE_IAP_APP_APPLE_ID=
# Sandbox until the app is live and you've verified real purchases.
APPLE_IAP_ENVIRONMENT=Sandbox
# Where hosted checkout returns after success/cancel — these are pages on the
# marketing website (apps/web), which bounce mobile back into the app. In prod
# use the website domain, e.g. https://lexiroot.app/subscription/success.
CHECKOUT_SUCCESS_URL=http://localhost:5174/subscription/success
CHECKOUT_CANCEL_URL=http://localhost:5174/subscription/cancel
# Days a past-due / cancelled subscription keeps access past period end.
SUBSCRIPTION_GRACE_DAYS=3
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EXPO_PUSH_ACCESS_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=LexiRoot <onboarding@resend.dev>
# Base URL of the admin dashboard, used to build admin invitation links.
ADMIN_URL=http://localhost:5173
